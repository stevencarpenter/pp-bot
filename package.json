{
  "name": "pp-bot",
  "version": "1.1.3",
  "description": "A Slack bot for ++ and -- votes and leaderboards for people and things",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "migrate": "npm run build && node dist/scripts/migrate.js",
    "test": "npm run test:build && node --experimental-vm-modules --no-warnings ./node_modules/jest/bin/jest.js",
    "test:coverage": "npm test -- --coverage",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:integration": "npm test -- db.integration.test.js --runInBand --coverage=false",
    "ci": "npm ci && npm run build && npm test",
    "lock:regen": "rm -f package-lock.json && npm install --package-lock-only",
    "test:build": "node -e \"require('node:fs').rmSync('build/test', { recursive: true, force: true })\" && tsc --project tsconfig.test.json"
  },
  "keywords": [
    "slack",
    "bot",
    "leaderboard"
  ],
  "author": "Steven Carpenter",
  "license": "MIT",
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "axios": "^1.21.0",
    "pg": "^8.23.1"
  },
  "overrides": {
    "glob": "^14.0.6",
    "test-exclude": {
      ".": "^7.0.2",
      "minimatch": "^11.0.9"
    },
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "babel-jest": "^30.4.1",
    "jest": "^30.1.3",
    "pg-mem": "^3.0.14",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true
  }
}
